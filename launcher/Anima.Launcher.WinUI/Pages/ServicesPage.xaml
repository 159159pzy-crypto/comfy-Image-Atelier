<?xml version="1.0" encoding="utf-8"?>
<local:LauncherPage x:Class="Anima.Launcher.Pages.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anima.Launcher.Pages"
    xmlns:launch="using:Anima.Launcher"
    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="4,0,4,12" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource StudioPanelStyle}" Padding="24">
                <Grid x:Name="WelcomeGrid" ColumnSpacing="28" RowSpacing="16" SizeChanged="Welcome_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="YOUR CREATIVE WORKSPACE" Style="{StaticResource StudioKickerStyle}" />
                        <TextBlock x:Name="WelcomeTitle" Text="创作，从这里开始。" Style="{StaticResource StudioHeadingStyle}" />
                        <TextBlock x:Name="WelcomeDescription" Text="准备环境、放入模型，然后打开你的 Anima 创作工作台。" Style="{StaticResource StudioBodyStyle}" MaxWidth="580" HorizontalAlignment="Left" />
                        <TextBlock x:Name="EnvironmentPath" FontSize="11" Foreground="{ThemeResource StudioTertiaryBrush}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <StackPanel x:Name="WelcomeActions" Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="204">
                        <Button x:Name="StartAllButton" Content="开始安装" Click="StartAll_Click" Style="{StaticResource StudioPrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                        <Button x:Name="ConfigureButton" Content="安装与环境设置" Click="Configure_Click" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource StudioPanelStyle}" Padding="22,18">
                <Grid ColumnSpacing="18" RowSpacing="12" SizeChanged="Folders_SizeChanged">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="把喜欢的模型放进来" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                        <TextBlock Text="复制文件后，到「模型资源」重新扫描。" Style="{StaticResource StudioBodyStyle}" FontSize="12" />
                    </StackPanel>
                    <StackPanel x:Name="FolderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="LoRA 文件夹" Tag="loras" Click="Folder_Click" />
                        <Button Content="底模文件夹" Tag="diffusion_models" Click="Folder_Click" />
                        <Button x:Name="MoreFoldersButton" Content="更多文件夹">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Checkpoint 底模" Tag="checkpoints" Click="Folder_Click" />
                                    <MenuFlyoutItem Text="VAE" Tag="vae" Click="Folder_Click" />
                                    <MenuFlyoutItem Text="文本编码器" Tag="text_encoders" Click="Folder_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,6,0,0">
                <TextBlock Text="服务状态" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                <TextBlock Text="自动检测 · 约每 3 秒更新" FontSize="11" Foreground="{ThemeResource StudioTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Grid x:Name="ServicesGrid" ColumnSpacing="14" SizeChanged="Services_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <launch:ServiceCard x:Name="ComfyCard" Title="ComfyUI" GlyphText="&#xE7B8;"
                    StartClicked="ComfyStart_Click" StopClicked="ComfyStop_Click" OpenClicked="ComfyOpen_Click" />
                <launch:ServiceCard x:Name="StudioCard" Grid.Column="1" Title="Studio 工作台" GlyphText="&#xE91B;"
                    StartClicked="StudioStart_Click" StopClicked="StudioStop_Click" OpenClicked="StudioOpen_Click" />
            </Grid>
            <TextBlock Text="停止操作只影响由本启动器创建的服务。关闭窗口后，运行中的任务会继续留在托盘。" Style="{StaticResource StudioBodyStyle}" FontSize="11" Margin="8,0" />
        </StackPanel>
    </ScrollViewer>
</local:LauncherPage>
