<?xml version="1.0" encoding="utf-8"?>
<local:LauncherPage x:Class="Anima.Launcher.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anima.Launcher.Pages"
    xmlns:launch="using:Anima.Launcher">
    <local:LauncherPage.Resources>
        <CollectionViewSource x:Name="ModelView" IsSourceGrouped="True" ItemsPath="Items" />
    </local:LauncherPage.Resources>
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="4,4,4,16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="5" Margin="8,0">
                <TextBlock Text="YOUR MODEL LIBRARY" Style="{StaticResource StudioKickerStyle}" />
                <TextBlock Text="模型与灵感，放在一起。" Style="{StaticResource StudioHeadingStyle}" />
                <TextBlock Text="基础模型按需下载，LoRA 随时添加。文件夹入口会读取当前 ComfyUI 的实际配置。" Style="{StaticResource StudioBodyStyle}" />
            </StackPanel>
            <Border Style="{StaticResource StudioPanelStyle}" Padding="22">
                <StackPanel Spacing="12">
                    <StackPanel x:Name="FolderActions" Orientation="Horizontal" Spacing="8" SizeChanged="FolderActions_SizeChanged">
                        <Button Content="LoRA 文件夹" Tag="loras" Click="Folder_Click" />
                        <Button Content="底模文件夹" Tag="diffusion_models" Click="Folder_Click" />
                        <Button x:Name="MoreFoldersButton" Content="更多文件夹">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Checkpoint 底模" Tag="checkpoints" Click="Folder_Click" />
                                    <MenuFlyoutItem Text="VAE" Tag="vae" Click="Folder_Click" />
                                    <MenuFlyoutItem Text="文本编码器" Tag="text_encoders" Click="Folder_Click" />
                                    <MenuFlyoutItem Text="本地反推模型" Tag="wd_taggers" Click="Folder_Click" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Anima 底模放在 diffusion_models；LoRA 放在 loras。若配置了多个位置，点击后可选择目标文件夹。" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StudioPanelStyle}" Padding="18">
                <StackPanel Spacing="12">
                    <ContentControl x:Name="ModelActions" HorizontalContentAlignment="Stretch" IsTabStop="False">
                    <Grid x:Name="DownloadActionsGrid" ColumnSpacing="8" RowSpacing="10" SizeChanged="DownloadActions_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="重新扫描" Click="Rescan_Click" />
                            <Button Content="更多操作">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="选择基础生成包" Click="SelectBase_Click" />
                                        <MenuFlyoutItem Text="完整哈希检查" Click="HashScan_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="生成一张测试图" Click="TestImage_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <Button x:Name="DownloadButton" Grid.Column="1" Content="下载所选模型" Click="Download_Click" Style="{StaticResource StudioPrimaryButtonStyle}" />
                    </Grid>
                    </ContentControl>
                    <TextBlock x:Name="EmptyNote" Text="还没有扫描模型。先导入或安装 ComfyUI，再点击「重新扫描」。" Style="{StaticResource StudioBodyStyle}" Margin="8,14" />
                    <StackPanel x:Name="DownloadProgressPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock x:Name="BatchText" Style="{StaticResource StudioBodyStyle}" AutomationProperties.AutomationId="ModelsBatchDetails" />
                        <ProgressBar x:Name="ModelsBatchBar" Minimum="0" Maximum="100" AutomationProperties.AutomationId="ModelsBatchProgress" />
                        <TextBlock x:Name="CurrentResourceText" Style="{StaticResource StudioBodyStyle}" />
                        <ProgressBar x:Name="ModelsFileBar" Minimum="0" Maximum="100" />
                    </StackPanel>
                    <TextBlock Text="本地反推为可选功能，推荐 PixAI 0.9；只下载勾选的模型。每个模型包全部校验后才可识别，暂停或取消可保留进度续传。" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                    <ListView x:Name="ModelList" ItemsSource="{x:Bind ModelView.View, Mode=OneWay}"
                        SelectionMode="Single" MaxHeight="420" MinHeight="120"
                        ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,10" />
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="launch:ModelRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect, Mode=OneWay}" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="{x:Bind Name}" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource StudioTextBrush}" />
                                        <TextBlock Text="{x:Bind PathText}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource StudioTertiaryBrush}" ToolTipService.ToolTip="{x:Bind PathText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MaxWidth="170">
                                        <Border Background="{ThemeResource StudioMutedBrush}" CornerRadius="10" Padding="9,4">
                                            <TextBlock Text="{x:Bind StateText}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Text="{x:Bind SizeText}" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource StudioTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" Margin="8,16,0,6" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListView.GroupStyle>
                    </ListView>
                </StackPanel>
            </Border>
            <Expander Header="模型详情与来源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="Details" Text="选择一个模型查看来源、校验与授权。" Style="{StaticResource StudioBodyStyle}" IsTextSelectionEnabled="True" />
                    <StackPanel x:Name="DetailActions" Orientation="Horizontal" Spacing="8" SizeChanged="DetailActions_SizeChanged">
                        <Button x:Name="OpenLocationButton" Content="打开所在文件夹" Click="OpenModelDir_Click" IsEnabled="False" />
                        <Button x:Name="OpenLicenseButton" Content="查看来源与授权" Click="OpenLicense_Click" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</local:LauncherPage>
