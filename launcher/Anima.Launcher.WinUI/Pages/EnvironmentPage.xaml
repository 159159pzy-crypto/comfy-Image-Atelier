<?xml version="1.0" encoding="utf-8"?>
<local:LauncherPage x:Class="Anima.Launcher.Pages.EnvironmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Anima.Launcher.Pages"
    xmlns:launch="using:Anima.Launcher">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="4,4,4,16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="5" Margin="8,0,8,4">
                <TextBlock Text="ENVIRONMENT" Style="{StaticResource StudioKickerStyle}" />
                <TextBlock Text="管理你的创作环境。" Style="{StaticResource StudioHeadingStyle}" />
                <TextBlock Text="检查 ComfyUI、插件和自定义节点的更新，修复依赖并调整下载来源。新建或导入其他环境请打开安装向导。" Style="{StaticResource StudioBodyStyle}" />
                <Button x:Name="OpenSetupButton" Content="新建 / 导入环境向导" Click="OpenSetup_Click" Margin="0,8,0,0" />
            </StackPanel>
            <Border x:Name="InstallationProgressPanel" Visibility="Collapsed" Style="{StaticResource StudioPanelStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="环境安装任务" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                    <TextBlock x:Name="InstallationStatusText" Style="{StaticResource StudioBodyStyle}" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="EnvironmentInstallationStatus" />
                    <ProgressBar x:Name="InstallationProgressBar" Minimum="0" Maximum="100" Height="5" AutomationProperties.AutomationId="EnvironmentInstallationProgress" />
                    <TextBlock x:Name="InstallationTransferText" Style="{StaticResource StudioBodyStyle}" FontSize="12" />
                    <ScrollViewer MaxHeight="110" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="InstallationErrorText" Style="{StaticResource StudioBodyStyle}" IsTextSelectionEnabled="True" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PauseInstallationButton" Content="暂停安装" Click="PauseInstallation_Click" AutomationProperties.AutomationId="EnvironmentPauseInstallation" />
                        <Button x:Name="ResumeInstallationButton" Content="继续安装" Click="ResumeInstallation_Click" AutomationProperties.AutomationId="EnvironmentResumeInstallation" />
                        <HyperlinkButton Content="查看下载详情" Click="InstallationDetails_Click" AutomationProperties.AutomationId="EnvironmentDownloadDetails" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="LegacySetupSteps" Visibility="Collapsed" Background="{ThemeResource StudioMutedBrush}" CornerRadius="18" Padding="18,14">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="01  选择方式" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource StudioAccentBrush}" />
                    <TextBlock Grid.Column="1" Text="02  选择目录并检查" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="03  查看内容与下载量" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="04  安装" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="05  开始创作" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource StudioSecondaryBrush}" />
                </Grid>
            </Border>
            <launch:Card Header="这台电脑" IconGlyph="&#xE950;" Description="系统、显卡和磁盘">
                <launch:Card.ActionContent>
                    <TextBlock x:Name="SystemInfo" Text="正在检测系统…" Style="{StaticResource StudioBodyStyle}" MaxWidth="550" />
                </launch:Card.ActionContent>
            </launch:Card>
            <Border Style="{StaticResource StudioPanelStyle}">
                <ContentControl x:Name="ComfyMaintenancePanel" HorizontalContentAlignment="Stretch" IsTabStop="False">
                <StackPanel Spacing="12">
                    <TextBlock Text="ComfyUI 稳定版本与依赖" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                    <TextBlock x:Name="CurrentEnvironmentText" Style="{StaticResource StudioBodyStyle}" FontSize="12" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ComfyVersionStatus" Style="{StaticResource StudioBodyStyle}" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="OptionalDependencyStatusText" Style="{StaticResource StudioBodyStyle}" FontSize="12" IsTextSelectionEnabled="True" />
                    <Grid ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button Content="检查稳定版本" Click="CheckComfy_Click" Margin="0,0,8,8" />
                        <Button Grid.Column="1" x:Name="UpdateComfyButton" Content="备份并更新 ComfyUI" Click="UpdateComfy_Click" />
                        <Button Grid.Row="1" x:Name="RollbackComfyButton" Content="回退上次 ComfyUI 更新" Click="RollbackComfy_Click" />
                        <Button Grid.Row="1" Grid.Column="1" Content="修复 Manager 与可选依赖" Click="RepairComfy_Click" />
                    </Grid>
                </StackPanel>
                </ContentControl>
            </Border>
            <Border Style="{StaticResource StudioPanelStyle}">
                <ContentControl x:Name="NodeMaintenancePanel" HorizontalContentAlignment="Stretch" IsTabStop="False">
                    <StackPanel Spacing="12">
                        <TextBlock Text="插件与自定义节点" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                        <TextBlock Text="检查已启用 Git 节点的最新版本，固定目标后再更新。更新前备份节点、Python 和配置；有本地修改的节点会保留并说明原因。" Style="{StaticResource StudioBodyStyle}" />
                        <TextBlock Text="Manager 依赖遵循当前 ComfyUI 的兼容版本要求，可使用上方的依赖修复操作。" Style="{StaticResource StudioBodyStyle}" FontSize="12" />
                        <TextBlock x:Name="NodeVersionStatus" Style="{StaticResource StudioBodyStyle}" IsTextSelectionEnabled="True" />
                        <Grid ColumnSpacing="8" RowSpacing="8" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Content="检查节点更新" Click="CheckNodes_Click" />
                            <Button Grid.Column="1" x:Name="UpdateNodesButton" Content="备份并更新节点" Click="UpdateNodes_Click" />
                            <Button Grid.Row="1" x:Name="RollbackNodesButton" Content="回退上次节点更新" Click="RollbackNodes_Click" />
                        </Grid>
                        <ItemsControl x:Name="NodeUpdateList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource StudioMutedBrush}" CornerRadius="12" Padding="12" Margin="0,4,0,0">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource StudioTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{ThemeResource StudioSecondaryBrush}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Version}" Style="{StaticResource StudioBodyStyle}" FontSize="12" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource StudioBodyStyle}" FontSize="12" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </Border>
            <ContentControl x:Name="ConfigurationPanel" HorizontalContentAlignment="Stretch" IsTabStop="False">
            <StackPanel Spacing="14">
                <Border x:Name="LegacyLocationPanel" Visibility="Collapsed" Style="{StaticResource StudioPanelStyle}">
                    <StackPanel Spacing="18">
                        <TextBlock Text="01  选择新建或导入" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{ThemeResource StudioMutedBrush}" CornerRadius="15" Padding="14">
                                <RadioButton x:Name="FreshMode" GroupName="InstallMode" Checked="Mode_Changed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="全新安装" FontWeight="SemiBold" />
                                        <TextBlock Text="NVIDIA 显卡 · 自动准备完整环境" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                            <Border Grid.Column="1" Background="{ThemeResource StudioMutedBrush}" CornerRadius="15" Padding="14">
                                <RadioButton x:Name="ImportMode" GroupName="InstallMode" Checked="Mode_Changed">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="导入已有 ComfyUI" FontWeight="SemiBold" />
                                        <TextBlock Text="复用模型与环境 · 保留现有节点" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource StudioSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="7">
                            <TextBlock x:Name="RootLabel" Text="02  选择安装位置" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="RootBox" PlaceholderText="例如 D:\AnimaStudio" TextChanged="Root_Changed" />
                                <Button Grid.Column="1" Content="选择文件夹" Click="PickRoot_Click" />
                            </Grid>
                            <TextBlock x:Name="RootHelp" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                        </StackPanel>
                        <Expander x:Name="PythonSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="手动选择 Python（可选）">
                            <StackPanel Spacing="8">
                                <TextBlock Text="自动识别 .venv、venv 和便携版 Python；只有自动识别失败时才需要指定。" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="PythonBox" PlaceholderText="留空自动识别 python.exe" TextChanged="Python_Changed" />
                                    <Button Grid.Column="1" Content="选择文件" Click="PickPython_Click" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StudioPanelStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="下载设置" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="7">
                                <TextBlock Text="下载来源" Foreground="{ThemeResource StudioSecondaryBrush}" FontSize="12" />
                                <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch" SelectionChanged="Source_Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Text="基础模型" Foreground="{ThemeResource StudioSecondaryBrush}" FontSize="12" />
                                <Border Background="{ThemeResource StudioMutedBrush}" CornerRadius="12" Padding="13,9">
                                    <TextBlock x:Name="ProfileText" Text="Anima · 底模 / 文本编码器 / VAE" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource StudioTextBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="默认选择 Anima。已存在的模型会复用；高级修复模型可在「模型资源」按需添加。" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                        <ComboBox x:Name="NetworkModeBox" Header="网络连接" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <ComboBoxItem Content="系统代理" Tag="system" />
                            <ComboBoxItem Content="直接连接" Tag="direct" />
                            <ComboBoxItem Content="自定义 HTTP 代理" Tag="custom" />
                        </ComboBox>
                        <TextBox x:Name="ProxyBox" Header="自定义代理地址" PlaceholderText="http://127.0.0.1:7890" />
                        <TextBlock Text="设置应用于下载、Git、uv 与 pip。系统 PAC 无法统一应用时会提示选择直连或明确的 HTTP 代理。暂停任务保留原设置。" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="高级下载设置">
                            <StackPanel Spacing="12" Margin="0,6,0,0">
                                <TextBox x:Name="GitMirrorBox" Header="Git HTTPS 镜像模板" PlaceholderText="HTTPS 前缀或包含 {url} 的模板" TextChanged="Input_Changed" />
                                <TextBox x:Name="HfMirrorBox" Header="Hugging Face 镜像" TextChanged="Input_Changed" />
                                <TextBox x:Name="PipBox" Header="Python 包索引" TextChanged="Input_Changed" />
                                <TextBox x:Name="CustomRepoBox" Header="自定义 ComfyUI 仓库（须包含选定的官方稳定提交）" TextChanged="Input_Changed" />
                                <TextBlock Text="下载设置仅应用于本项目，不修改系统 Git / pip 配置。" Style="{StaticResource StudioBodyStyle}" FontSize="11" />
                            </StackPanel>
                        </Expander>
                        <Button Content="保存下载设置" Click="SaveSources_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border x:Name="LegacyPreviewPanel" Visibility="Collapsed" Style="{StaticResource StudioPanelStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="03  查看安装内容与下载量" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                        <TextBlock x:Name="InstallSummary" Text="选择目录后，检查所需下载和磁盘空间。安装中断后可继续，已完成的下载和步骤会复用。" Style="{StaticResource StudioBodyStyle}" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="检查安装内容" Click="Preview_Click" />
                            <Button x:Name="ImportCheckButton" Content="检查 / 导入目录" Click="Check_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="LegacyInstallPanel" Visibility="Collapsed" Background="{ThemeResource StudioAccentSoftBrush}" CornerRadius="22" Padding="24,20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="04  安装" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextBrush}" />
                        <TextBlock x:Name="InstallHelp" Style="{StaticResource StudioBodyStyle}" FontSize="12" />
                        <TextBlock x:Name="InstallGateNote" Text="请先检查上方安装内容，再开始安装。" Style="{StaticResource StudioBodyStyle}" FontSize="12" />
                        <Button x:Name="InstallButton" Content="一键安装并准备模型" Click="Install_Click" IsEnabled="False" Style="{StaticResource StudioPrimaryButtonStyle}" />
                        <TextBlock Text="05  完成后回到概览，点击「启动并打开工作台」开始创作。" Style="{StaticResource StudioBodyStyle}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</local:LauncherPage>
