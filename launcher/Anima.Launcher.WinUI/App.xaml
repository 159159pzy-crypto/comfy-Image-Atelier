<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Anima.Launcher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Palette and radii mirror the Studio workbench's static/styles.css. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#ECEDF1" />
                    <AcrylicBrush x:Key="StudioChromeBrush" TintColor="#FCFCFE" TintOpacity="0.78" FallbackColor="#F7F7FA" />
                    <AcrylicBrush x:Key="StudioSurfaceBrush" TintColor="#FFFFFF" TintOpacity="0.72" FallbackColor="#F7F7FA" />
                    <SolidColorBrush x:Key="StudioMutedBrush" Color="#19787880" />
                    <SolidColorBrush x:Key="StudioPressedBrush" Color="#2B787880" />
                    <SolidColorBrush x:Key="StudioTextBrush" Color="#1D1D1F" />
                    <SolidColorBrush x:Key="StudioSecondaryBrush" Color="#67676C" />
                    <SolidColorBrush x:Key="StudioTertiaryBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="StudioSeparatorBrush" Color="#1C3C3C43" />
                    <SolidColorBrush x:Key="StudioEdgeBrush" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="#0071E3" />
                    <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#1F0071E3" />
                    <SolidColorBrush x:Key="StudioSuccessBrush" Color="#248A3D" />
                    <SolidColorBrush x:Key="StudioWarningBrush" Color="#B25000" />
                    <SolidColorBrush x:Key="StudioDangerBrush" Color="#D70015" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1D1D1F" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#67676C" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8E8E93" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0071E3" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0071E3" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0077ED" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="#0A0A0D" />
                    <AcrylicBrush x:Key="StudioChromeBrush" TintColor="#26262C" TintOpacity="0.82" FallbackColor="#232327" />
                    <AcrylicBrush x:Key="StudioSurfaceBrush" TintColor="#3A3A40" TintOpacity="0.62" FallbackColor="#232327" />
                    <SolidColorBrush x:Key="StudioMutedBrush" Color="#17EBEBF5" />
                    <SolidColorBrush x:Key="StudioPressedBrush" Color="#29EBEBF5" />
                    <SolidColorBrush x:Key="StudioTextBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="StudioSecondaryBrush" Color="#A1A1A6" />
                    <SolidColorBrush x:Key="StudioTertiaryBrush" Color="#86868B" />
                    <SolidColorBrush x:Key="StudioSeparatorBrush" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="StudioEdgeBrush" Color="#21FFFFFF" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="#380A84FF" />
                    <SolidColorBrush x:Key="StudioSuccessBrush" Color="#30D158" />
                    <SolidColorBrush x:Key="StudioWarningBrush" Color="#FF9F0A" />
                    <SolidColorBrush x:Key="StudioDangerBrush" Color="#FF453A" />
                    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#A1A1A6" />
                    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#86868B" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#409CFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="StudioBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioChromeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="StudioMutedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="StudioPressedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StudioTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="StudioAccentSoftBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="StudioSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="StudioDangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">18</CornerRadius>
            <Style x:Key="StudioButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource StudioMutedBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource StudioTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
            <Style TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}" />
            <Style x:Key="StudioPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="24,11" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{ThemeResource StudioAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Style>
            <Style x:Key="StudioNavButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource StudioSecondaryBrush}" />
                <Setter Property="Padding" Value="17,9" />
            </Style>
            <Style x:Key="StudioHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource StudioTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StudioKickerStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource StudioTertiaryBrush}" />
            </Style>
            <Style x:Key="StudioBodyStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{ThemeResource StudioSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="StudioPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource StudioSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StudioSeparatorBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="Padding" Value="24" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
