<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>AnimaLauncherEntry</AssemblyName>
    <Product>Comfy Image Atelier</Product>
    <AssemblyTitle>Comfy Image Atelier</AssemblyTitle>
    <Description>Comfy Image Atelier launcher entry</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>../Anima.Launcher.WinUI/app.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
